# Copie para .env e preencha. O .env NÃO vai para o git nem para a imagem Docker.

# Token que os clientes (robô, script do cliente) mandam em "Authorization: Bearer <token>"
# Gere um valor longo e aleatório, ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN=

# Fallback com IA para extratos sem layout (opcional).
# No Docker, o docker-compose.yml já aponta para o container "ollama" (perfil "ia").
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# SFTP do servidor do cliente (rotas /sftp/listar e /extratos/sftp)
SFTP_HOST=
SFTP_PORTA=22
SFTP_USUARIO=
# Autenticação: chave (recomendado) OU senha.
# No Docker, a chave fica em ./sftp/ e o caminho é o de dentro do container: /run/sftp/id_ed25519
SFTP_CHAVE=
SFTP_SENHA=
# Pasta raiz dos extratos no servidor do cliente (equivale ao Z:\A PAGAR\AEROFLEX).
# No OpenSSH do Windows o caminho fica no formato /D:/A PAGAR/AEROFLEX
SFTP_PASTA_BASE=
# Arquivo com a chave pública do servidor (no Docker o compose já define /run/sftp/known_hosts)
SFTP_KNOWN_HOSTS=sftp/known_hosts
